.construction-workspace {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 24px;
  color: #f8fafc;
}

.cw-workspace-header,
.cw-metrics,
.cw-toolbar,
.cw-grid-shell,
.cw-save-bar {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(2, 6, 23, 0.98));
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
}

.cw-workspace-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 24px;
}

.cw-workspace-header span,
.cw-metrics span,
.cw-project-select label {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cw-workspace-header h1 {
  margin: 6px 0;
  font-size: 34px;
  line-height: 1;
}

.cw-workspace-header p {
  margin: 0;
  color: #94a3b8;
}

.cw-project-select {
  min-width: 260px;
}

.cw-project-select select,
.cw-toolbar input,
.cw-toolbar select,
.cw-grid input,
.cw-grid select {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.96);
  color: #f8fafc;
  padding: 10px 11px;
  outline: none;
  font: inherit;
}

.cw-project-select select {
  margin-top: 8px;
}

.cw-metrics {
  display: grid;
  grid-template-columns: 1.7fr repeat(4, 1fr);
  gap: 12px;
  padding: 16px;
}

.cw-metrics div {
  padding: 14px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.05);
}

.cw-metrics strong {
  display: block;
  margin-top: 6px;
  font-size: 22px;
}

.weight-good {
  color: #86efac;
}

.weight-bad {
  color: #fca5a5;
}

.cw-save-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 16px;
}

.cw-save-bar strong,
.cw-save-bar span {
  display: block;
}

.cw-save-bar span {
  margin-top: 4px;
  color: #94a3b8;
  font-size: 13px;
}

.cw-save-bar button {
  border: 0;
  cursor: pointer;
  color: white;
  font-weight: 900;
  border-radius: 12px;
  background: #16a34a;
  padding: 11px 16px;
}

.cw-save-bar button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.cw-toolbar {
  display: grid;
  grid-template-columns: 1.4fr 200px 170px 140px 280px 190px 170px 170px;
  gap: 12px;
  padding: 16px;
  align-items: center;
}

.cw-toolbar button,
.cw-grid button {
  border: 0;
  cursor: pointer;
  color: white;
  font-weight: 900;
  border-radius: 12px;
  background: #2563eb;
  padding: 10px 12px;
}

.cw-toolbar button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.cw-secondary-action {
  height: 38px;
  padding: 0 14px !important;
  border-radius: 10px !important;
  background: rgba(37, 99, 235, 0.35) !important;
  border: 1px solid rgba(96, 165, 250, 0.45) !important;
}

.cw-danger-action {
  width: auto !important;
  min-width: 140px !important;
  height: 38px !important;
  padding: 0 14px !important;
  border-radius: 10px !important;
  font-size: 13px !important;
  font-weight: 850 !important;
  line-height: 1 !important;
  border: 1px solid rgba(248, 113, 113, 0.38) !important;
  background: rgba(127, 29, 29, 0.26) !important;
  color: #fecaca !important;
}

.cw-danger-action:hover {
  background: rgba(127, 29, 29, 0.42) !important;
}

.cw-danger-action:disabled {
  opacity: 0.45 !important;
  cursor: not-allowed !important;
}

.cw-grid-shell {
  overflow: auto;
  min-height: 620px;
}

.cw-grid {
  width: 100%;
  min-width: 1880px;
  border-collapse: separate;
  border-spacing: 0;
}

.cw-grid th {
  position: sticky;
  top: 0;
  z-index: 3;
  background: #020617;
  color: #94a3b8;
  font-size: 11px;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  text-align: left;
  padding: 13px 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.cw-grid td {
  height: 62px;
  padding: 9px 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  background: rgba(15, 23, 42, 0.72);
  vertical-align: middle;
}

.cw-grid tbody tr:hover td {
  background: rgba(30, 41, 59, 0.92);
}

.cw-grid th:first-child,
.cw-grid td:first-child {
  width: 44px !important;
  min-width: 44px !important;
  max-width: 44px !important;
  padding: 0 8px !important;
  text-align: center;
}

.cw-grid th:nth-child(2),
.cw-grid td:nth-child(2) {
  position: sticky;
  left: 44px;
  z-index: 2;
  background: #020617;
  min-width: 110px;
}

.cw-grid th:nth-child(3),
.cw-grid td:nth-child(3) {
  position: sticky;
  left: 154px;
  z-index: 2;
  background: #020617;
  min-width: 360px;
}

.cw-grid th:first-child,
.cw-grid th:nth-child(2),
.cw-grid th:nth-child(3) {
  z-index: 4;
}

.cw-grid input,
.cw-grid select {
  min-height: 42px;
}

.cw-grid input[type="checkbox"] {
  width: 16px !important;
  height: 16px !important;
  min-height: 16px !important;
  padding: 0 !important;
  margin: 0 auto;
  cursor: pointer;
  accent-color: #2563eb;
}

.baseline-activity-cell input {
  min-width: 330px;
  font-weight: 900;
}

.cw-row-dirty td {
  background: rgba(37, 99, 235, 0.18) !important;
}

.cw-delete-row {
  background: rgba(239, 68, 68, 0.22) !important;
  color: #fecaca !important;
}

.cw-delete-row:hover {
  background: rgba(239, 68, 68, 0.42) !important;
}

.cw-empty {
  padding: 32px;
  color: #94a3b8;
}

@media (max-width: 1180px) {
  .cw-workspace-header {
    flex-direction: column;
  }

  .cw-metrics,
  .cw-toolbar {
    grid-template-columns: 1fr;
  }
}

/* ---------- Weekly production enterprise ---------- */

.weekly-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

.weekly-toolbar {
  grid-template-columns: 1.5fr 240px !important;
}

.cw-weekly-grid {
  min-width: 1380px;
}

.cw-weekly-grid th:first-child,
.cw-weekly-grid td:first-child {
  width: auto !important;
  min-width: 110px !important;
  max-width: none !important;
  padding: 9px 10px !important;
  text-align: left !important;
}

.cw-weekly-grid th:nth-child(2),
.cw-weekly-grid td:nth-child(2) {
  position: sticky;
  left: 0;
  z-index: 2;
  background: #020617;
  min-width: 420px;
}

.cw-activity-readonly {
  font-weight: 900;
  color: #f8fafc;
}

@media (max-width: 1180px) {
  .weekly-actions {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
  }

  .weekly-toolbar {
    grid-template-columns: 1fr !important;
  }
}

/* ---------- Weekly week navigation ---------- */

.weekly-period-bar {
  display: grid;
  grid-template-columns: 180px 1fr 180px;
  align-items: center;
  gap: 14px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(2, 6, 23, 0.98));
  padding: 16px;
}

.weekly-period-bar button {
  height: 42px;
  border: 1px solid rgba(96, 165, 250, 0.32);
  border-radius: 12px;
  background: rgba(37, 99, 235, 0.22);
  color: #bfdbfe;
  font-weight: 900;
  cursor: pointer;
}

.weekly-period-bar div {
  text-align: center;
}

.weekly-period-bar span,
.weekly-period-bar small {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.weekly-period-bar strong {
  display: block;
  margin: 5px 0;
  font-size: 26px;
}

@media (max-width: 980px) {
  .weekly-period-bar {
    grid-template-columns: 1fr;
  }
}

